{
  "name": "kurra-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint . && npm run typecheck",
    "format": "prettier --write .",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --strict",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@lingui/core": "^5.9.5",
    "@lingui/message-utils": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@radix-ui/react-tabs": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-icons": "^16.32.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@lingui/format-po": "^5.9.5",
    "@lingui/vite-plugin": "^5.9.5",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-lingui": "^0.16.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.2.7"
  }
}
